# AGNI - AI Personal Assistant Environment Configuration

# AGNI_API_KEY: Required for AGNI AI Neural Engine and Multimodal Services.
AGNI_API_KEY=""

# GROQ_API_KEY: Free fast AI inference via Groq (get key at https://console.groq.com)
# When set, AGNI uses Groq as primary AI brain for ultra-fast responses (~200ms)
# Falls back to AGNI Neural Engine if Groq is unavailable
GROQ_API_KEY=""

# Server Port
PORT=3000
