{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/?source=pwa",
  "name": "AGNI - AI Personal Assistant",
  "short_name": "AGNI",
  "description": "Made in India AI Personal Assistant with Voice, Vision, Learning, and Smart Life OS. Speak Tamil or English — AGNI replies like Jarvis.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#000000",
  "theme_color": "#ff2a39",
  "categories": [
    "productivity",
    "utilities",
    "education",
    "personalization"
  ],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
