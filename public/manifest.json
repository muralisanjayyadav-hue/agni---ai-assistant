      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "AGNI AI Personal Assistant - Home"
    }
  ],
  "shortcuts": [
    {
      "name": "AGNI Voice Assistant",
      "short_name": "Voice",
      "description": "Launch Siri-like AGNI Voice Assistant directly",
      "url": "/?action=voice",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Offline Mode",
      "short_name": "Offline",
      "description": "Access offline NCERT summaries, formulas, and flashcards",
      "url": "/?action=offline",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Camera & Vision",
      "short_name": "Vision",
      "description": "Analyze textbook questions or diagrams with AI camera",
      "url": "/?action=vision",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "description": "Adjust preferences, voice, and language settings",
      "url": "/?action=settings",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "id": "com.agni.assistant",
      "url": "https://play.google.com/store/apps/details?id=com.agni.assistant"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  }
}
