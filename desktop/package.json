{
  "name": "agni-desktop",
  "productName": "AGNI",
  "version": "1.0.0",
  "description": "AGNI laptop EXE: your /jarvis page plus real Windows control",
  "main": "main.js",
  "author": "Sanjay",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable --x64",
    "make": "electron-builder --win --x64",
    "dist": "electron-builder --win --x64 --config electron-builder.yml",
    "build:win": "electron-builder --win nsis portable --x64",
    "start:prod": "electron ."
  },
  "dependencies": {
    "loudness": "^0.4.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.sanjay.agni",
    "productName": "AGNI",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "system.js", "system-ipc.js", "config.js", "index.html", "orb.html"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "AGNI Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "AGNI ${version}.${ext}"
    }
  }
}
